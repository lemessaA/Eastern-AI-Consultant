# =============================================================================
# Eastern AI Consultant — Staging Environment
# =============================================================================
# Use for staging/QA. Copy to .env.staging and fill in real values.
# DO NOT COMMIT actual secrets - use Vercel/Cloud secret management.
# =============================================================================

ENVIRONMENT=staging
DEBUG=false

# Database (managed PostgreSQL - Neon, Supabase, RDS, etc.)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
# SYNC_DATABASE_URL=postgresql+psycopg2://user:pass@host:port/db

# Redis (managed - Upstash, Redis Cloud, etc.)
# REDIS_URL=redis://user:pass@host:port/0

# Security - Generate: openssl rand -base64 48
# SECRET_KEY=
# JWT_SECRET=
# JWT_ALGORITHM=RS256  (recommended for staging/production)
# JWT_PRIVATE_KEY=  (base64 encoded)
# JWT_PUBLIC_KEY=   (base64 encoded)

# CORS - Staging domains
# CORS_ORIGINS=https://staging.example.com,https://staging-api.example.com

# LLM
# GROQ_API_KEY=
# OPENAI_API_KEY=

# OAuth (Google Cloud Console - staging redirect)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://staging-api.example.com/api/v1/auth/google/callback

# Storage (S3/Cloudinary for staging)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=staging-bucket

# Vector store
# VECTOR_STORE_PATH=/app/chroma_db

# Rate limit
RATE_LIMIT_PER_MINUTE=60