# =============================================================================
# Eastern AI Consultant — Development Environment
# =============================================================================
# Use for local development only. Copy to .env.development
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# Database (local Docker Compose)
DATABASE_URL=postgresql+asyncpg://eastern_ai:eastern_ai@localhost:5432/eastern_ai
SYNC_DATABASE_URL=postgresql+psycopg2://eastern_ai:eastern_ai@localhost:5432/eastern_ai

# Redis (local Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Security - Generate: openssl rand -base64 48
SECRET_KEY=dev-secret-change-me-32-chars-minimum
JWT_SECRET=dev-jwt-change-me-32-chars-minimum
JWT_ALGORITHM=HS256

# CORS - Local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# LLM (add your keys)
GROQ_API_KEY=
OPENAI_API_KEY=

# OAuth (Google Cloud Console - local redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Storage (local)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Vector store
VECTOR_STORE_PATH=chroma_db

# Rate limit (lenient for dev)
RATE_LIMIT_PER_MINUTE=120