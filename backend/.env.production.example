# =============================================================================
# Eastern AI Consultant — Production Environment
# =============================================================================
# Use for production. DO NOT COMMIT - use Vercel/Cloud secret management.
# Set these in: Vercel Dashboard → Settings → Environment Variables
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# Database (managed PostgreSQL with connection pooling)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db?sslmode=require
# SYNC_DATABASE_URL=postgresql+psycopg2://user:pass@host:port/db?sslmode=require
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# Redis (managed with TLS)
# REDIS_URL=rediss://user:pass@host:port/0

# Security - Generate: openssl rand -base64 48
# SECRET_KEY=
# JWT_SECRET=
# JWT_ALGORITHM=RS256  (REQUIRED for production)
# JWT_PRIVATE_KEY=  (base64 encoded RSA private key)
# JWT_PUBLIC_KEY=   (base64 encoded RSA public key)

# CORS - Production domains ONLY (https, no trailing slashes)
# CORS_ORIGINS=https://app.example.com,https://api.example.com

# LLM
# GROQ_API_KEY=
# OPENAI_API_KEY=

# OAuth (Google Cloud Console - production redirect)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# Storage (S3/Cloudinary with proper permissions)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=production-bucket

# Vector store (persistent volume)
# VECTOR_STORE_PATH=/app/chroma_db

# Rate limit (strict for production)
RATE_LIMIT_PER_MINUTE=30