# =============================================================================
# Eastern AI Consultant API — Backend Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Do NOT commit .env.
# For production, use your cloud provider's secret management (Vercel, AWS, etc.)
#
# Generate secrets with: openssl rand -base64 48
# Generate RSA keys for RS256: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode: base64 -w0 private.pem  (and same for public.pem)
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=Eastern AI Consultant API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- Database (async URL for SQLAlchemy app, sync for alembic) ---
# Format: postgresql+asyncpg://user:pass@host:port/db  (app)
#         postgresql+psycopg2://user:pass@host:port/db  (alembic)
DATABASE_URL=postgresql+asyncpg://eastern_ai:eastern_ai@localhost:5432/eastern_ai
SYNC_DATABASE_URL=postgresql+psycopg2://eastern_ai:eastern_ai@localhost:5432/eastern_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security (CRITICAL - NO DEFAULTS IN PRODUCTION) ---
# Generate with: openssl rand -base64 48
SECRET_KEY=
JWT_SECRET=

# JWT Algorithm: HS256 (dev) or RS256 (production - requires keys below)
JWT_ALGORITHM=HS256

# For RS256 in production (base64-encoded PEM keys):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# PRODUCTION: Comma-separated https origins, no trailing slashes
# Example: CORS_ORIGINS=https://app.example.com,https://api.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM Providers ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- OAuth (Google Sign-In) ---
# Create in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Storage ---
# Options: local, s3, cloudinary
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDINARY_URL=

# --- Vector Store ---
VECTOR_STORE_PATH=chroma_db
VECTOR_COLLECTION=eai_knowledge

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60