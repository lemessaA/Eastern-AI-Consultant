# =============================================================================
# Eastern AI Consultant — Root Environment Variables (Docker Compose)
# =============================================================================
# Copy to .env and fill in real values. Do NOT commit .env.
# These are used by docker-compose.yml for infrastructure services.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=eastern_ai
POSTGRES_PASSWORD=  # Generate: openssl rand -base64 32
POSTGRES_DB=eastern_ai
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (FastAPI) ---
API_PORT=8000
# Generate with: openssl rand -base64 48
API_SECRET_KEY=
API_JWT_SECRET=
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Providers ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OAuth (Google Sign-In) ---
# Same Client ID used in frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage ---
# Options: local, s3, cloudinary
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDINARY_URL=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@easternaiconsultant.com

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=