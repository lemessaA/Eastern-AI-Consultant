# =============================================================================
# Eastern AI Consultant — Frontend (Next.js) Public Environment Variables
# =============================================================================
# Copy to .env.local and fill in real values. Do NOT commit .env.local.
# These are PUBLIC variables (prefixed with NEXT_PUBLIC_) - safe for client bundles.
# For secrets, use Vercel Dashboard → Settings → Environment Variables.
# =============================================================================

# --- API ---
# PRODUCTION: Full API origin only, https, no trailing slash
# Example: NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Eastern AI Consultant

# --- OAuth (Google Sign-In) ---
# Same Client ID as backend GOOGLE_CLIENT_ID (Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Payments (Stripe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional Analytics/Tracking ---
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=